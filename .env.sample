PORT=4000 #development port
NODE_ENV=development
PAYSTACK_SECRET_KEY=XXXX
PAYSTACK_API_BASE_URL=https://api.paystack.co
POSTGRES_HOST=localhost #development
POSTGRES_PORT=5432 #development
POSTGRES_USER= #development
POSTGRES_PASSWORD= #development
POSTGRES_DB=account #development
DB_TYPE=postgres
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRY=15m
MININUM_APPROVAL_AMOUNT=1000000


TEST_PAYSTACK_SECRET_KEY=XXXX
TEST_PAYSTACK_API_BASE_URL=https://api.paystack.co
TEST_POSTGRES_HOST=localhost #test
TEST_POSTGRES_PORT=5432 #test
TEST_POSTGRES_USER= #test
TEST_POSTGRES_PASSWORD=
TEST_POSTGRES_DB=account_test #test
DB_TYPE=postgres

# Security policies. Access tokens without these claims are invalidated on rollout.
JWT_ISSUER=wallet-system
JWT_AUDIENCE=wallet-system-api
CORS_ORIGINS=
TRUSTED_PROXIES=
SWAGGER_ENABLED=false

# Remote production databases require verify-full and a trusted CA.
POSTGRES_SSL_MODE=disable # local development; use verify-full for remote production
POSTGRES_SSL_CA_FILE=
# Compose supplies disable only for its private database network.
# POSTGRES_USER/PASSWORD are bootstrap credentials, never API credentials.
POSTGRES_MIGRATION_USER=wallet_migrator
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_RUNTIME_USER=wallet_runtime
POSTGRES_RUNTIME_PASSWORD=
